  },
  "tool_choice": "required",
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "inspect_relation",
        "description": "Read-only 2D relation comparison, no action.",
        "parameters": {
          "type": "object",
          "properties": {
            "target_visible": {
              "type": "string",
