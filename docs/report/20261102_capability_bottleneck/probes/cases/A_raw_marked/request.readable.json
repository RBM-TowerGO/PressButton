                "yes",
                "no",
                "uncertain"
              ]
            },
            "reference_visible": {
              "type": "string",
              "enum": [
                "yes",
                "no",
                "uncertain"
              ]
            },
            "vertical": {
              "type": "string",
              "enum": [
                "above",
                "level",
                "below",
                "unknown"
              ]
            },
            "horizontal": {
              "type": "string",
              "enum": [
                "left",
                "center",
                "right",
                "unknown"
              ]
            }
          },
          "required": [
            "target_visible",
            "reference_visible",
            "vertical",
            "horizontal"
          ],
          "additionalProperties": false
        }
      }
    }
  ],
  "messages": [
    {
      "role": "system",
      "content": "Compare the target T to reference P in a 2D image coordinate system: x increases toward image RIGHT, y increases toward image BOTTOM. Return inspect_relation once, without prose. The relations describe T relative to P, never robot motion or 3D contact. Identify each referent in the supplied image. If a referent cannot be identified, report its visibility uncertain or no and keep unsupported relations unknown. These are offline saved or diagnostic images, never a live control request."
    },
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "Target T: the center of the small colored point labelled T. Reference P: the center of the small colored point labelled P. Compare these two annotated points only; do not infer contact or robot movement."
        },
        {
          "type": "image_url",
          "image_url": {
            "url": "../../images/28a42c509c9a8b312532aa80fc6b2ea36089892a9fd0ee7b71634a3933b35783.jpg"
          }
        }
      ]
    }
  ]
